# Server Configuration
PORT=8000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tax_docs?schema=public

# ONLYOFFICE Configuration
ONLYOFFICE_URL=http://localhost:80
ONLYOFFICE_JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Storage Configuration
STORAGE_ROOT=./uploads

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Configuration (for API authentication if needed)
JWT_SECRET=your_api_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
